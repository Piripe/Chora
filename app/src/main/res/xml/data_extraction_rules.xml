<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The smart cache can be huge and is downloaded again on refresh. -->
        <exclude domain="file" path="smart_cache/"/>
        <exclude domain="database" path="smart_cache.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="smart_cache/"/>
        <exclude domain="database" path="smart_cache.db"/>
    </device-transfer>
</data-extraction-rules>